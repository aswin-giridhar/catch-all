# Magic — dashboard.magic.link → Embedded Wallet → publishable key.
# Safe to ship in the browser. The sk_live_ secret key is NOT used by this app.
NEXT_PUBLIC_MAGIC_API_KEY=pk_live_...

# Particle — dashboard.particle.network
# Project ID and Client Key come from the project itself.
NEXT_PUBLIC_PARTICLE_PROJECT_ID=
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=
# App ID comes from a WEB APP created inside that project. Not the server key.
NEXT_PUBLIC_PARTICLE_APP_ID=

# Any Arbitrum One RPC. The public endpoint is fine for a demo.
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
